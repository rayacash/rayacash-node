{
  "name": "rayacash",
  "version": "1.0.0",
  "description": "SDK oficial de Node.js para la API de Raya Cash: pagos por transferencia, transferencias, balance y webhooks.",
  "keywords": [
    "raya",
    "raya cash",
    "pagos",
    "transferencias",
    "cvu",
    "cbu",
    "argentina",
    "api",
    "sdk"
  ],
  "homepage": "https://raya.cash/api",
  "bugs": {
    "url": "https://github.com/rayacash/rayacash-node/issues",
    "email": "soporte@raya.cash"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayacash/rayacash-node.git"
  },
  "license": "MIT",
  "author": "Raya Cash <soporte@raya.cash>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "check:package": "publint --strict && attw --pack . && node scripts/check-package.mjs",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "prepack": "node scripts/build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.20.5",
    "publint": "^0.3.25",
    "typescript": "^7.0.2"
  }
}
